# ==============================================================================
# EXEMPLO DE CONFIGURAÇÃO - ACRONIS CYBER PROTECT CLOUD API
# ==============================================================================

# URL base do Data Center da Acronis
ACRONIS_URL=https://br02-cloud.acronis.com

# Credenciais do Cliente da API (OAuth2)
CLIENT_ID=seu_client_id_aqui
CLIENT_SECRET=seu_client_secret_aqui

# (Opcional) Tenant ID
TENANT_ID=

# Modo de Operação (false para produção/API oficial)
MOCK_MODE=false

# Porta local do servidor
PORT=8000

# Chave Mestra e Porta do Painel de Controle de Utilizadores Externo/Isolado
ADMIN_MASTER_KEY=AcronisCyberAdminMasterKey#2026!
ADMIN_PORT=8001
