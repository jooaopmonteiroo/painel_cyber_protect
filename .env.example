# ------------------------------------------------------------------------------
# 1. AUTENTICAÇÃO E SESSÃO SEGURA (ZERO-TRUST)
# ------------------------------------------------------------------------------
# Chave secreta de alta entropia para assinatura de cookies e tokens de sessão
SESSION_SECRET=c5d88691500dbf7cf09a1a1f0a221f7db287e07ffcfd55cf64dcb9dbefb686ee

# Chave Mestra para o Console Administrativo Externo (/admin na porta 8001)
ADMIN_MASTER_KEY=AcronisCyberAdminMasterKey#2026!
ADMIN_PORT=8001

# Porta HTTP do painel principal (FastAPI / Uvicorn)
PORT=8000

# ------------------------------------------------------------------------------
# 2. INTEGRAÇÃO UBIQUITI UNIFI OS / UDM PRO / SITE MANAGER CLOUD API
# ------------------------------------------------------------------------------
# Opção A: UniFi Site Manager Cloud API (Recomendado se não houver IP público fixo na UDM)
# URL: https://api.ui.com
# UNIFI_API_KEY gerada em: https://unifi.ui.com (Account Settings -> API Keys)
UNIFI_CONTROLLER_URL=https://api.ui.com
UNIFI_API_KEY=wYX-aOJp0eG8XClmuNzGUBL05qW86tzk

# Opção B: Conexão Direta à UDM Pro local (via Túnel VPN WireGuard ou IP LAN)
# UNIFI_CONTROLLER_URL=https://192.168.14.1
# UNIFI_USERNAME=admin
# UNIFI_PASSWORD=sua_senha_local_udm
# UNIFI_SITE=default

# Site padrão da controladora
UNIFI_SITE=default

# Desabilitar validação estrita de SSL apenas se conectar direto ao IP interno da UDM Pro
UNIFI_VERIFY_SSL=false

# Modo Mock / Simulação (false para produção 100% dados reais da UDM Pro)
UNIFI_MOCK=false

# ------------------------------------------------------------------------------
# 3. ACRONIS CYBER PROTECT CLOUD API
# ------------------------------------------------------------------------------
# URL base do Data Center da Acronis
ACRONIS_URL=https://br02-cloud.acronis.com

# Credenciais OAuth2 (Client Credentials)
CLIENT_ID=seu_client_id_acronis
CLIENT_SECRET=seu_client_secret_acronis

# (Opcional) Tenant ID da organização
TENANT_ID=

# Modo Mock para dados Acronis (false para produção oficial)
MOCK_MODE=false
