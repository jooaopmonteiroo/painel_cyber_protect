# ==============================================================================
# MODELO DE CONFIGURAÇÃO (.env.example) - SOC JM CYBER PROTECT
# Copie para .env e preencha com as credenciais reais de produção.
# ==============================================================================

# 1. API ACRONIS CYBER PROTECT CLOUD (BR02)
ACRONIS_BASE_URL=https://br02-cloud.acronis.com
ACRONIS_URL=https://br02-cloud.acronis.com
ACRONIS_CLIENT_ID=seu_client_id_acronis
ACRONIS_CLIENT_SECRET=seu_client_secret_acronis
ACRONIS_TENANT_ID=
MOCK_MODE=false

# 2. API UBIQUITI UNIFI NETWORK CONTROLLER
UNIFI_CONTROLLER_URL=https://192.168.15.1:8443
UNIFI_USERNAME=admin
UNIFI_PASSWORD=sua_senha_unifi
UNIFI_SITE_ID=default
UNIFI_CHECK_SSL=false

# 3. PARÂMETROS GERAIS
ENVIRONMENT=production
API_REFRESH_INTERVAL=30s
PORT=8000

# 4. SEGURANÇA MÁXIMA PARA VPS (JWT, RBAC, RATE LIMITING)
JWT_SECRET_KEY=ChaveSecretaAleatoriaMin32CaracteresProducao!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_SOC_COMMANDS_MAX=30
ALLOWED_ORIGINS=*

# 5. DISPARO DE NOTIFICAÇÕES CRÍTICAS POR E-MAIL (SMTP)
EMAIL_SMTP_SERVER=smtp.office365.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER=soc-alertas@jmcyberprotect.com
EMAIL_PASSWORD=senha_do_email_ou_app_password

# 6. CONSOLE ADMINISTRATIVO ISOLADO
ADMIN_MASTER_KEY=AcronisCyberAdminMasterKey#2026!
ADMIN_PORT=8001

